@page "/Cobro/Edit/{CobroId:int}"

@inject CobrosService cobroService
@inject DeudoresService deudoresService
@inject PrestamosService prestamosService
@inject NavigationManager navigationManager
@inject ToastService toastService
@inject IJSRuntime JS

<PageTitle>Edit</PageTitle>
<EditForm Model="Cobro" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Editar Cobro</h5>
            </div>

            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label"><strong>CobroId</strong></label>
                    <InputNumber class="form-control" @bind-Value="Cobro.CobroId" readonly></InputNumber>
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Fecha</strong></label>
                    <InputDate class="form-control" @bind-Value="Cobro.Fecha"></InputDate>
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Deudor</strong></label>
                    <input class="form-control" value="@Deudor.Nombres" readonly />
                </div>

                <div class="border border-success p-3 mt-3">
                    <h5>Detalles del Cobro</h5>

                    <PrestamoPicker Prestamos="ListaPrestamos"
                                    PrestamoId="DetalleSeleccionado.PrestamoId"
                                    Valor="DetalleSeleccionado.ValorCobrado"
                                    OnPrestamoSelected="HandlePrestamoSelected" />
                    <hr />

                    <QuickGrid Items="@Cobro.CobrosDetalle.AsQueryable()" Class="table table-light text-center">
                        <PropertyColumn Property="d => d.PrestamoId" Title="PréstamoId" />
                        <PropertyColumn Property="d => d.ValorCobrado" Title="Cobrado" />
                        <TemplateColumn Title="Remover" Context="detalle">
                            <button type="button" class="btn btn-outline-danger bi bi-trash"
                                    @onclick="() => RemoverDetalle(detalle)">
                            </button>
                        </TemplateColumn>
                    </QuickGrid>
                    <hr />
                </div>
                <div class="row mt-2">
                    <div class="col-6 offset-6">
                        <div class="mb-3">
                            <label class="form-label"><strong>Monto</strong></label>
                            <label class="form-control text-end"><strong>@Cobro.Monto</strong></label>

                            <ValidationMessage For="(() => Cobro.Monto)" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer text-center mt-2">
                <a href="/Cobro/Index" class="btn btn-secondary"> <span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
            </div>
        </div>
    </div>
</EditForm>


@code {
    [Parameter]
    public int CobroId { get; set; }
    public Cobros Cobro { get; set; } = new Cobros();
    public PrestamoDetalle DetalleSeleccionado { get; set; } = new PrestamoDetalle();
    public Deudores Deudor { get; set; } = new Deudores();
    public List<Prestamos> ListaPrestamos { get; set; } = new List<Prestamos>();

    public string Mensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var cobroEncontrado = await cobroService.Buscar(CobroId);

        if (cobroEncontrado != null)
        {
            Cobro = cobroEncontrado;

            var deudorEncontrado = await deudoresService.Buscar(Cobro.DeudorId);
            if (deudorEncontrado != null)
            {
                Deudor = deudorEncontrado;
            }

            Cobro.Fecha = DateTime.Now;
            ListaPrestamos = await prestamosService.GetList(p => p.DeudorId == Cobro.DeudorId);
        }
    }

    public async Task BuscarPrestamosPendientes()
    {
        ListaPrestamos = await prestamosService.GetPrestamosPendientes(Cobro.DeudorId);
    }

    private void HandlePrestamoSelected((Prestamos prestamo, double valor) selection)
    {
        PrestamoDetalle detalle = new PrestamoDetalle();
        detalle.PrestamoId = selection.prestamo.PrestamoId;
        detalle.ValorCobrado = selection.valor;

        Cobro.CobrosDetalle.Add(detalle);

        double montoTotal = 0;
        foreach (var item in Cobro.CobrosDetalle)
        {
            montoTotal = montoTotal + item.ValorCobrado;
        }
        Cobro.Monto = montoTotal;

        DetalleSeleccionado = new PrestamoDetalle();
    }

    public async Task Modificar()
    {
        var paso = await cobroService.Guardar(Cobro);

        if (paso)
        {
            toastService.ShowSuccess("Se ha modificado correctamente");
            navigationManager.NavigateTo("/Cobro/Index");
        }
        else
        {
            toastService.ShowError("No se ha podido modificar correctamente");
        }
    }

    public async Task RemoverDetalle(PrestamoDetalle detalle)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Está seguro de que desea eliminar este detalle?");

        if (confirmado == false)
        {
            return;
        }

        Cobro.CobrosDetalle.Remove(detalle);
        DetalleSeleccionado = detalle;
    }
}
